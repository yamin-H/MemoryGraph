# MemoryGraph Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# HydraDB OSS (Graph Database)
# Use 'neo4j://hydradb:7687' inside Docker Compose, 'neo4j://127.0.0.1:7687' for local
HYDRADB_URI=neo4j://127.0.0.1:7687
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
GRAPH_NAMESPACE=default
GRAPH_CELL_ID=cell-0

# Groq API Key (REQUIRED for LLM fact extraction & query synthesis)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Redis (caching, rate limiting, metrics)
REDIS_URL=redis://localhost:6379

# PostgreSQL + pgvector (Vector RAG baseline for benchmarks only)
POSTGRES_URL=postgresql://localhost:5432/memorygraph_baseline
